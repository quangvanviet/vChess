{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".write": "auth != null && !newData.exists() && data.child('meta').child('hostUid').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.hasChildren(['ruleVersion','mode','seed','status','hostUid','createdAt','turnLimitMs'])",
          ".validate": "newData.hasChildren(['ruleVersion','mode','seed','status','hostUid','createdAt','turnLimitMs']) && (data.exists() || newData.child('status').val() === 'lobby')",
          "ruleVersion": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "mode": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4"
          },
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".write": "auth != null && ((data.val() === 'lobby' && newData.val() === 'playing' && root.child('rooms').child($roomId).child('meta').child('hostUid').val() === auth.uid) || (data.val() === 'playing' && newData.val() === 'finished' && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()))",
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'finished'"
          },
          "hostUid": {
            ".validate": "newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "turnLimitMs": {
            ".validate": "newData.isNumber() && newData.val() >= 30000 && newData.val() <= 604800000"
          },
          "$other": {
            ".validate": false
          }
        },
        "seats": {
          ".read": "auth != null",
          "$seat": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('meta').child('status').val() === 'lobby' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (!newData.exists() && root.child('rooms').child($roomId).child('meta').child('hostUid').val() === auth.uid))",
            ".validate": "newData.isString() && ($seat === '1' || $seat === '2' || ($seat === '3' && root.child('rooms').child($roomId).child('meta').child('mode').val() >= 3) || ($seat === '4' && root.child('rooms').child($roomId).child('meta').child('mode').val() >= 4))"
          }
        },
        "players": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('meta').child('status').val() === 'lobby'",
            ".validate": "newData.hasChildren(['seat','name','race','passive','homeTileType','ready'])",
            "seat": {
              ".validate": "newData.isString() && root.child('rooms').child($roomId).child('seats').child(newData.val()).val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "race": {
              ".validate": "newData.val() === 'rong' || newData.val() === 'nhan' || newData.val() === 'tien' || newData.val() === 'quy'"
            },
            "passive": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
            },
            "homeTileType": {
              ".validate": "newData.val() === 'gold' || newData.val() === 'food' || newData.val() === 'wood'"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "turn": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('meta').child('hostUid').val() === auth.uid && newData.child('nextSeq').val() === 1) || (data.exists() && newData.child('nextSeq').val() === data.child('nextSeq').val() + 1 && (root.child('rooms').child($roomId).child('seats').child(data.child('seat').val()).val() === auth.uid || (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && now > data.child('startedAt').val() + root.child('rooms').child($roomId).child('meta').child('turnLimitMs').val()))))",
          ".validate": "newData.hasChildren(['seat','startedAt','nextSeq'])",
          "seat": {
            ".validate": "newData.isString() && newData.val().matches(/^[1-4]$/)"
          },
          "startedAt": {
            ".validate": "newData.val() === now"
          },
          "nextSeq": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "commands": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$seq": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists() && newData.exists() && root.child('rooms').child($roomId).child('meta').child('status').val() === 'playing' && (root.child('rooms').child($roomId).child('seats').child(root.child('rooms').child($roomId).child('turn').child('seat').val()).val() === auth.uid || now > root.child('rooms').child($roomId).child('turn').child('startedAt').val() + root.child('rooms').child($roomId).child('meta').child('turnLimitMs').val())",
            ".validate": "newData.hasChildren(['seq','uid','turnNo','payload','stateHash','ts']) && newData.child('seq').val() === root.child('rooms').child($roomId).child('turn').child('nextSeq').val() && $seq === newData.child('seq').val() + ''",
            "seq": {
              ".validate": "newData.isNumber()"
            },
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "turnNo": {
              ".validate": "newData.isNumber() && newData.val() >= 1"
            },
            "payload": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 6000"
            },
            "stateHash": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "result": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['winnerSeat','endedAt'])",
          "winnerSeat": {
            ".validate": "newData.isString() && newData.val().matches(/^[1-4]$/)"
          },
          "endedAt": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "chat": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid','name','text','ts'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "days": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$day": {
            "c": {
              "$seat": {
                ".write": "auth != null && root.child('rooms').child($roomId).child('seats').child($seat).val() === auth.uid && !root.child('rooms').child($roomId).child('days').child($day).child('lock').exists()",
                ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
              }
            },
            "r": {
              "$seat": {
                ".write": "auth != null && root.child('rooms').child($roomId).child('seats').child($seat).val() === auth.uid && !data.exists() && root.child('rooms').child($roomId).child('days').child($day).child('lock').exists()",
                ".validate": "newData.hasChildren(['p','n']) && newData.child('p').isString() && newData.child('p').val().length <= 12000 && newData.child('n').isString() && newData.child('n').val().length <= 64"
              }
            },
            "lock": {
              ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists()",
              ".validate": "newData.hasChildren(['at','seats']) && newData.child('at').isNumber() && newData.child('seats').isString()"
            },
            "fin": {
              ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && !data.exists()",
              ".validate": "newData.hasChildren(['at','seats']) && newData.child('at').isNumber() && newData.child('seats').isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "quit": {
          ".read": "root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
          "$seat": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('seats').child($seat).val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (newData.exists() ? ((!data.exists() && newData.child('hostUid').val() === auth.uid && root.child('rooms').child($roomId).child('meta').child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid)) : (data.child('hostUid').val() === auth.uid || !root.child('rooms').child($roomId).child('meta').exists() || root.child('rooms').child($roomId).child('meta').child('status').val() !== 'lobby'))",
        ".validate": "newData.hasChildren(['hostUid','mode','status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "hostUid": {
          ".validate": "newData.val() === data.val() || !data.exists()"
        }
      }
    },
    "lobbyChat": {
      ".read": "auth != null",
      "$msgId": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['uid','name','text','ts'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "rating"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "rating": {
          ".validate": "newData.isNumber()"
        },
        "history": {
          "$h": {
            ".validate": "newData.hasChildren(['at'])"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}